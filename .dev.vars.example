ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_COOKIE_INSECURE=true   # 只在 localhost 時 =true

# (必填)使用哪個 AI 供應商。允許值:deepseek | anthropic
AI_PROVIDER=deepseek

# 使用 deepseek 時必填 DeepSeek API key
DEEPSEEK_API_KEY=
# 使用 anthropic 時必填 Anthropic API key
ANTHROPIC_API_KEY=

# 是否啟用"多輪對話記憶"功能。預設停用
# 停用:none(或留空)，啟用:d1(使用 Cloudflare D1 儲存)
CONVERSATION_STORE=d1

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

SCHEDULING_PROVIDER=google-calendar
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
