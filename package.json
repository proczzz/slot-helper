{
  "name": "slot-helper",
  "private": true,
  "type": "module",
  "description": "AI-powered customer service assistant with appointment booking",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proczzz/slot-helper"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:cloudflare": "wrangler dev",
    "dev:node": "node --watch --env-file=.env src/backend/infra/node.ts",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "build:web": "vite build",
    "build:node": "esbuild src/backend/infra/node.ts --bundle --minify --sourcemap --platform=node --format=cjs --outfile=dist/node.cjs",
    "deploy": "npm run build:web && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "docker:build": "docker build -t slot-helper-node .",
    "docker:up": "docker compose up --build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.56",
    "@ai-sdk/deepseek": "^3.0.47",
    "@hono/node-server": "^2.1.1",
    "ai": "^7.0.105",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "llm-lister": "^0.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.44",
    "esbuild": "^0.28.2",
    "prettier": "3.9.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
