ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_COOKIE_INSECURE=true   # 只在 localhost 時 =true

# (必填)使用哪個 AI 供應商。允許值:deepseek | anthropic
AI_PROVIDER=deepseek
# AI_PROVIDER=anthropic

# 使用 deepseek 時必填 DeepSeek API key
DEEPSEEK_API_KEY=
# 使用 anthropic 時必填 Anthropic API key
ANTHROPIC_API_KEY=

# 對話記憶資料庫存放目錄。僅在"啟用多輪對話記憶"時有效。預設值:.
CONVERSATION_DB_DIR=.
# 對話記憶資料庫檔案名稱。僅在"啟用多輪對話記憶"時有效。預設值:conversations.db
CONVERSATION_DB_NAME=conversations.db

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

SCHEDULING_PROVIDER=google-calendar
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
