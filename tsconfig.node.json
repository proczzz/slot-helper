{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"]
  },
  "include": [
    "src/backend/adapter/**/*.ts",
    "src/backend/boot/*.ts",
    "src/backend/core/**/*.ts",
    "src/backend/db/sqlite.ts",
    "src/backend/db/types.ts",
    "src/backend/infra/node.ts",
    "src/backend/model/**/*.ts",
    "src/backend/repository/*.ts",
    "src/backend/routes/*.ts",
    "src/backend/service/*ts",
    "src/version.ts"
  ]
}
