{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["./worker-configuration.d.ts"]
  },
  "include": [
    "src/backend/ai/**/*.ts",
    "src/backend/app/**/*.ts",
    "src/backend/channels/**/*.ts",
    "src/backend/core/**/*.ts",
    "src/backend/infra/cloudflare.ts",
    "src/backend/providers/conversation-store/d1.ts",
    "src/backend/providers/scheduling/*.ts"
  ]
}
